# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================================================
# IDE & editors
# =============================================================================
.idea/
*.swp
*.swo
*~

# VS Code — ignore local settings, keep shared team config
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Cursor (local AI/editor state)
.cursor/

# =============================================================================
